// this is the Jenkins pipeline I'm using to automate all the fetching and reporting - you can plunder this to create a similar script
// you'll probably need to replace the checkout with a direct copy of the code to the appropriate place (/home/james/code/ashridge) 

pipeline {
    agent { label 'ainola'}

    stages {
			
		stage('Setup') {
            steps {
                sh 'docker stop jenkins_reg || echo ****************'
                sh 'docker rm jenkins_reg || echo **************** '
                // sh 'export GIT_AUTH_HEADER="Basic Z2l0OmdpdAo=" && docker build --secret id=GIT_AUTH_HEADER -t jwyper/ashridge http://192.168.0.96:8090/ashridge.git#release:docker'
                //
                // ** I fetch the dockerfile from my git repo every time; this command will need changing to work with a local Dockerfile
                sh 'DOCKER_BUILDKIT=0 docker build -t jwyper/ashridge http://192.168.0.96:8090/ashridge.git#release:docker'
                sh 'docker run -d --name jenkins_reg -v /home/james/.netrc:/home/james/.netrc jwyper/ashridge'
                sh 'docker exec -u james jenkins_reg bash -c "mkdir -p /home/james/code /home/james/data" '
                sh 'docker cp /home/james/agent/data/master.xlsx jenkins_reg:/home/james/data/master.xlsx'
                sh 'docker cp /home/james/agent/data/spp.csv jenkins_reg:/home/james/data/spp.csv'
                sh 'docker exec -u james jenkins_reg bash -c "sh /home/james/checkout" '

            }    
        }
        stage('Wholegame Extract - Registrations and Teams') {
            steps {
                retry (4) { sh 'docker exec -u james jenkins_reg bash -c "ruby /home/james/ashridge/src/fa_complete.rb" '}
                sleep 120
                sh 'docker exec -u james jenkins_reg bash -c "mv /home/james/Downloads/*RegistrationReport* /home/james/data/wg_reg.xlsx " '
                sh 'docker exec -u james jenkins_reg bash -c "mv /home/james/Downloads/*TeamQual* /home/james/data/wg_quals.xlsx " '
            }
        }
        stage('GotSport Extract - exports') {
            steps {
                retry (4) { sh 'docker exec -u james jenkins_reg bash -c "ruby /home/james/ashridge/src/gs_dl.rb" ' }
                sh 'docker exec -u james jenkins_reg bash -c "mv /home/james/Downloads/* /home/james/data/ " '
            }
        }
        stage('GotSport Extract - FAN details - get worklist') {
            steps {
                retry (4) { sh 'docker exec -u james jenkins_reg bash -c "ruby /home/james/ashridge/src/gs_get_fan_1_worklist.rb -d /home/james/data/report.db -p 4" ' }
                sh 'docker cp jenkins_reg:/home/james/data/report.db ./report.db'
            }
        }
        stage ('GotSport Extract - Launch parallel containers')
        {
            steps {
                sh 'for c in 1 2 3 4 ; do (docker stop jenkins_reg${c} || true ); (docker rm jenkins_reg${c} || true ); docker run -d --name jenkins_reg${c} -v /home/james/.netrc:/home/james/.netrc jwyper/ashridge ; docker exec -u james jenkins_reg${c} bash -c "mkdir -p /home/james/code /home/james/data" ; docker exec -u james jenkins_reg${c} bash -c "sh /home/james/checkout" ; done'
                sh 'for c in 1 2 3 4 ; do docker cp ./report.db jenkins_reg${c}:/home/james/data/report.db; done'
            }
        }
        stage('GotSport Extract - FAN details - process the worklist') {
            parallel {
                stage ('Ply 1') {
                    steps {
                        retry(8) { sh 'docker exec -u james jenkins_reg1 bash -c "ruby /home/james/ashridge/src/gs_get_fan_2_process.rb -p 1 -d /home/james/data/report.db" ' }
                    }
                }
                stage ('Ply 2') {
                    steps {
                        retry(8) { sh 'docker exec -u james jenkins_reg2 bash -c "ruby /home/james/ashridge/src/gs_get_fan_2_process.rb -p 2 -d /home/james/data/report.db" ' }
                    }
                }
                stage ('Ply 3') {
                    steps {
                        retry(8) { sh 'docker exec -u james jenkins_reg3 bash -c "ruby /home/james/ashridge/src/gs_get_fan_2_process.rb -p 3 -d /home/james/data/report.db" ' }
                    }
                }
                stage ('Ply 4') {
                    steps {
                        retry(8) { sh 'docker exec -u james jenkins_reg4 bash -c "ruby /home/james/ashridge/src/gs_get_fan_2_process.rb -p 4 -d /home/james/data/report.db" ' }
                    }
                }
            }
            
            
        }
        stage('GotSport Extract - Remove parallel containers')
        {
            steps
            {
                sh 'for c in 1 2 3 4 ; do docker cp jenkins_reg${c}:/home/james/data/report.db ./report${c}.db ; done '
                sh 'for c in 1 2 3 4 ; do docker stop jenkins_reg${c}; docker rm jenkins_reg${c} ; done '
            }
        }
        stage ('GotSport Extract - consolidate raw_gs_fan_etc tables')
        {
            steps
            {
                sh 'docker exec  -u james jenkins_reg bash -c "mkdir -p /home/james/data/parallel"'
                sh 'for c in 1 2 3 4; do docker cp ./report${c}.db jenkins_reg:/home/james/data/parallel/report${c}.db ; done'
                sh 'docker exec  -u james jenkins_reg bash -c "cd /home/james/data && sqlite3 /home/james/data/report.db < /home/james/ashridge/src/parallel.sql"'
            }
        }
        stage('GotSport Extract - Squad info') {
            steps {
                retry (4) { sh 'docker exec -u james jenkins_reg bash -c "ruby /home/james/ashridge/src/gs_squad_dl.rb -d /home/james/data" ' }
            }
        }
        stage ('Fetch Payment details from Google Drive')
        {
            steps
            {
                sh 'mkdir -p payments && rclone copyto gdrive: --include "/Ashridge_Park/Payments/*" payments/  --verbose'
                sh 'mv payments/Ashridge_Park/Payments/* payments/'
                sh 'rmdir payments/Ashridge_Park/Payments/ && rmdir payments/Ashridge_Park/'
                sh 'cp payments/$(ls -t payments | head -1) payments_latest.csv'
                sh 'docker cp payments_latest.csv jenkins_reg:/home/james/data/payments_latest.csv'
            }
        }
        stage('Load tables and report') {
            steps {
                sh 'docker exec  -u james jenkins_reg bash -c "ruby /home/james/ashridge/src/excel_to_sqlite.rb -x /home/james/data/ -d /home/james/data/report.db"'
                sh 'docker exec  -u james jenkins_reg bash -c "cd /home/james/data && sqlite3 /home/james/data/report.db < /home/james/ashridge/src/load_raw.sql"'
                sh 'docker exec  -u james jenkins_reg bash -c "cd /home/james/data && sqlite3 /home/james/data/report.db < /home/james/ashridge/src/staging.sql"'
                sh 'docker exec  -u james jenkins_reg bash -c "cd /home/james/data && sqlite3 /home/james/data/report.db < /home/james/ashridge/src/load_payments.sql"' 
                sh 'docker exec  -u james jenkins_reg bash -c "cd /home/james/data && sqlite3 /home/james/data/report.db < /home/james/ashridge/src/staging_payments.sql"' 
                sh 'docker exec  -u james jenkins_reg bash -c "cd /home/james/data && sqlite3 /home/james/data/report.db < /home/james/ashridge/src/load_spp.sql"' 
                sh 'docker exec  -u james jenkins_reg bash -c "cd /home/james/data && sqlite3 /home/james/data/report.db < /home/james/ashridge/src/staging_spp.sql"'                
                sh 'docker exec  -u james jenkins_reg bash -c "mkdir -p /home/james/data/output"'
                sh 'docker exec  -u james jenkins_reg bash -c "ruby /home/james/ashridge/src/sqlite_to_excel_player.rb -x /home/james/data/output -d /home/james/data/report.db"'
                
                sh 'docker cp jenkins_reg:/home/james/data/output .'
                sh 'docker cp jenkins_reg:/home/james/data/report.db .'
                archiveArtifacts artifacts: 'output/*.xlsx'
                
            }
            
        }
        stage('Upload to Google Drive')
        {
            steps {
                sh 'rclone copyto output/progress.xlsx gdrive:Ashridge_Park/Uploads/progress.xlsx'
                sh 'rclone copyto output/unmatched.xlsx gdrive:Ashridge_Park/Uploads/unmatched.xlsx'
            }
        }
    }
    post {
        always {
            emailext( attachLog: true, body: "Report attached", attachmentsPattern: '*.xlsx', subject:"Ashridge Registration Report", to: 'wyperjamesr@gmail.com')
        }      
        
    }
}


